# Groq default. Get a key at https://console.groq.com/keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Request budget for extraction. Use a larger value only for slower local models.
EXTRACTION_TIMEOUT_MS=1700

# Optional. Defaults to ./data/action-items.sqlite.
# DATABASE_PATH=./data/action-items.sqlite
